# --- GitHub ---
# Your GitHub Personal Access Token (classic with `repo` scope, or fine-grained with Pull requests: Read & Write)
GITHUB_TOKEN=your_github_token_here
# Any random string used to verify webhook payloads from GitHub
GITHUB_WEBHOOK_SECRET=your_random_secret_here
# GITHUB_API_BASE=https://api.github.com

# --- Ollama ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_TIMEOUT_S=120
# OLLAMA_TEMPERATURE=0.1

# --- Review behavior ---
# MAX_FILES_PER_PR=25
# MAX_PATCH_LINES_PER_FILE=400
# MAX_COMMENTS_PER_PR=30
# POST_SUMMARY_EVEN_IF_CLEAN=true
# REVIEW_EVENT=COMMENT

# IGNORED_PATH_PATTERNS=package-lock.json,yarn.lock,pnpm-lock.yaml,poetry.lock,*.min.js,*.min.css,*.svg,*.png,*.jpg,*.jpeg,*.lock,dist/*,build/*,vendor/*,node_modules/*

# PORT=8000
